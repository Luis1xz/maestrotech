# ========================================================
# MaestroTech — Configuración de Variables de Entorno
# ========================================================
# Duplica este archivo como .env.local y completa con tus credenciales de Supabase.

# 1. Variables Públicas del Cliente (accesibles en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. Clave Secreta del Servidor (EXCLUSIVA de Server Actions y API Routes)
# NUNCA le agregues el prefijo NEXT_PUBLIC_ ni la uses en componentes "use client"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Alias opcionales compatibles con Vite
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
