# ========================================================
# Legado Docente — Configuración de Variables de Entorno
# ========================================================
# Duplica este archivo como .env.local y completa con tus credenciales.

# 1. Variables Públicas del Cliente (accesibles en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SITE_URL=https://legadodocente.com

# 2. Clave Secreta de Supabase (EXCLUSIVA de Server Actions y API Routes)
# NUNCA le agregues el prefijo NEXT_PUBLIC_ ni la uses en componentes "use client"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. Cerebro de MaTech (Google Gemini API para Embeddings y Tutoría RAG)
# Obtén tu clave gratuita en: https://aistudio.google.com/
# Modelos: text-embedding-004 (768 dim) y gemini-1.5-flash
GEMINI_API_KEY=AIzaSy...

# Alias opcionales compatibles con Vite
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
